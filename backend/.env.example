# Reference only: the application does not automatically read .env files.
# In PowerShell, set: $env:OCEAN_DOCS_ENABLED = 'true'
# false disables /docs, its OAuth redirect, and /openapi.json together.
OCEAN_DOCS_ENABLED=true

# Defaults to this application's project root; no data is read at startup.
# Optional override must be an absolute path to a trusted local project.
# OCEAN_PROJECT_ROOT=C:/Users/pc/OneDrive/Desktop/ocean_2

# Readiness is 503 until explicit required prepared product IDs are configured.
# In PowerShell use a JSON list, for example after preparing the named product:
# $env:OCEAN_REQUIRED_PRODUCT_IDS = '["your_prepared_product_id"]'
OCEAN_REQUIRED_PRODUCT_IDS=[]

# Only explicit part-4 Copernicus operator acquisition needs these process variables.
# No .env file is loaded implicitly; startup/health never read provider credentials.
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
# Never put real secrets in this example, source code, or public frontend config.
